<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | Admin Cibuniwangi</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<style>
  body{background:#f4f6f9;}
  .sidebar{min-height:100vh;background:#1e293b;color:#fff;width:250px;position:fixed;top:0;left:0;overflow-y:auto;}
  .sidebar a{color:#cbd5e1;text-decoration:none;display:block;padding:.6rem 1rem;border-radius:.4rem;font-size:.92rem;}
  .sidebar a:hover, .sidebar a.active{background:#334155;color:#fff;}
  .sidebar .brand{font-weight:700;padding:1.2rem 1rem;font-size:1.1rem;border-bottom:1px solid #334155;}
  .sidebar .section-title{font-size:.72rem;text-transform:uppercase;color:#64748b;padding:1rem 1rem .3rem;}
  .main-content{margin-left:250px;padding:1.5rem;}
  .topbar{background:#fff;border-radius:.5rem;padding:.8rem 1.2rem;margin-bottom:1.2rem;box-shadow:0 1px 3px rgba(0,0,0,.06);}
  .card-stat{border:none;border-radius:.7rem;box-shadow:0 1px 4px rgba(0,0,0,.06);}
</style>
</head>
<body>
<nav class="sidebar">
  <div class="brand"><i class="bi bi-building me-2"></i> Desa Cibuniwangi</div>
  <div class="p-2">
    <a href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
    <div class="section-title">Profile Desa</div>
    <a href="/admin/profile-desa"><i class="bi bi-info-circle me-2"></i> Profile Desa</a>
    <a href="/admin/demografi_desa"><i class="bi bi-bar-chart me-2"></i> Demografi</a>
    <div class="section-title">Pemerintahan</div>
    <a href="/admin/struktur_organisasi"><i class="bi bi-diagram-2 me-2"></i> Struktur Organisasi</a>
    <a href="/admin/perangkat_desa"><i class="bi bi-people me-2"></i> Perangkat Desa</a>
    <a href="/admin/lembaga_desa"><i class="bi bi-diagram-3 me-2"></i> Lembaga Desa</a>
    <div class="section-title">Layanan</div>
    <a href="/admin/layanan_publik"><i class="bi bi-file-earmark-text me-2"></i> Layanan Publik</a>
    <a href="/admin/pengajuan_layanan"><i class="bi bi-inbox me-2"></i> Pengajuan Masuk</a>
    <div class="section-title">Informasi</div>
    <a href="/admin/kategori_berita"><i class="bi bi-tags me-2"></i> Kategori Berita</a>
    <a href="/admin/berita"><i class="bi bi-newspaper me-2"></i> Berita</a>
    <a href="/admin/pengumuman"><i class="bi bi-megaphone me-2"></i> Pengumuman</a>
    <a href="/admin/agenda_kegiatan"><i class="bi bi-calendar-event me-2"></i> Agenda Kegiatan</a>
    <a href="/admin/galeri"><i class="bi bi-images me-2"></i> Galeri</a>
    <a href="/admin/apb_desa"><i class="bi bi-cash-coin me-2"></i> APB Desa</a>
    <div class="section-title">Lainnya</div>
    <a href="/admin/potensi_desa"><i class="bi bi-shop me-2"></i> Potensi Desa</a>
    <a href="/admin/produk_hukum"><i class="bi bi-file-earmark-lock me-2"></i> Produk Hukum</a>
    <a href="/admin/kontak_pesan"><i class="bi bi-envelope me-2"></i> Pesan Masuk</a>
    <a href="/admin/kontak-desa"><i class="bi bi-geo-alt me-2"></i> Kontak & Lokasi</a>
    
    <% if (currentUser && currentUser.role === 'superadmin') { %>
    <div class="section-title">Administrasi</div>
    <a href="/admin/users"><i class="bi bi-person-gear me-2"></i> Management User</a>
    <% } %>

    <div class="section-title">Sesi</div>
    <a href="/admin/logout" class="text-danger fw-semibold"><i class="bi bi-box-arrow-right me-2"></i> Logout</a>
  </div>
</nav>

<div class="main-content">
  <!-- TOPBAR DENGAN TOMBOL LOGOUT ATAS -->
  <div class="topbar d-flex justify-content-between align-items-center">
    <h5 class="mb-0 fw-bold"><%= title %></h5>
    <div class="d-flex align-items-center gap-3">
      <div>
        <i class="bi bi-person-circle me-1"></i> <%= currentUser ? currentUser.name : 'Admin' %>
        <span class="badge bg-secondary text-uppercase ms-1"><%= currentUser ? currentUser.role : 'User' %></span>
      </div>

      <!-- Tombol Logout Topbar -->
      <a href="/admin/logout" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1">
        <i class="bi bi-box-arrow-right"></i> Logout
      </a>
    </div>
  </div>

  <% if (success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show"><%= success[0] %>
      <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show"><%= error[0] %>
      <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <%- body %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>