<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0"><i class="bi <%= cfg.icon %>"></i> <%= cfg.label %></h5>
  <a href="/admin/<%= moduleKey %>/create" class="btn btn-dark btn-sm"><i class="bi bi-plus-lg"></i> Tambah Data</a>
</div>

<div class="card card-stat p-3">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <% cfg.listColumns.forEach(col => { %>
            <th class="text-capitalize"><%= col.replace(/_/g,' ') %></th>
          <% }) %>
          <th class="text-end">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (items.length === 0) { %>
          <tr><td colspan="<%= cfg.listColumns.length + 1 %>" class="text-center text-muted py-4">Belum ada data.</td></tr>
        <% } %>
        <% items.forEach(item => { %>
          <tr>
            <% cfg.listColumns.forEach(col => { %>
              <td>
                <% const val = item[col]; %>
                <% if (typeof val === 'string' && val.length > 60) { %>
                  <%= val.substring(0, 60) %>...
                <% } else { %>
                  <%= val %>
                <% } %>
              </td>
            <% }) %>
            <td class="text-end">
              <a href="/admin/<%= moduleKey %>/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
              <form action="/admin/<%= moduleKey %>/<%= item.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Yakin ingin menghapus data ini?');">
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
