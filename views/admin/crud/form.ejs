<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0"><i class="bi <%= cfg.icon %>"></i> <%= title %></h5>
  <a href="/admin/<%= moduleKey %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Kembali</a>
</div>

<div class="card card-stat p-4">
  <form action="<%= mode === 'create' ? '/admin/' + moduleKey : '/admin/' + moduleKey + '/' + item.id %>"
        method="POST" enctype="multipart/form-data">
    <div class="row g-3">
      <% cfg.fields.forEach(f => { %>
        <div class="col-md-<%= (f.type === 'textarea' || f.type === 'richtext') ? 12 : 6 %>">
          <label class="form-label"><%= f.label %> <% if (f.required) { %><span class="text-danger">*</span><% } %></label>

          <% if (f.type === 'text' || f.type === 'number' || f.type === 'date' || f.type === 'datetime') { %>
            <input
              type="<%= f.type === 'datetime' ? 'datetime-local' : f.type %>"
              name="<%= f.name %>"
              class="form-control"
              value="<%= item[f.name] !== undefined && item[f.name] !== null ? item[f.name] : '' %>"
              <%= f.required ? 'required' : '' %>>

          <% } else if (f.type === 'textarea' || f.type === 'richtext') { %>
            <textarea name="<%= f.name %>" class="form-control" rows="<%= f.type === 'richtext' ? 8 : 3 %>"
              <%= f.required ? 'required' : '' %>><%= item[f.name] || '' %></textarea>

          <% } else if (f.type === 'select') { %>
            <select name="<%= f.name %>" class="form-select">
              <% f.options.forEach(opt => { %>
                <option value="<%= opt[0] %>" <%= String(item[f.name]) === String(opt[0]) ? 'selected' : '' %>><%= opt[1] %></option>
              <% }) %>
            </select>

          <% } else if (f.type === 'file') { %>
            <input type="file" name="<%= f.name %>" class="form-control" <%= (f.required && mode==='create') ? 'required' : '' %>>
            <% if (item[f.name]) { %>
              <div class="mt-2">
                <small class="text-muted">File saat ini:</small><br>
                <% if (/\.(jpg|jpeg|png|gif|webp)$/i.test(item[f.name])) { %>
                  <img src="/uploads/<%= item[f.name] %>" style="max-height:100px;border-radius:.4rem;" class="mt-1">
                <% } else { %>
                  <a href="/uploads/<%= item[f.name] %>" target="_blank"><%= item[f.name] %></a>
                <% } %>
              </div>
            <% } %>
          <% } %>
        </div>
      <% }) %>
    </div>

    <hr class="my-4">
    <button type="submit" class="btn btn-dark"><i class="bi bi-save"></i> Simpan</button>
    <a href="/admin/<%= moduleKey %>" class="btn btn-outline-secondary">Batal</a>
  </form>
</div>
