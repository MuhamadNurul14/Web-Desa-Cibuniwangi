<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0"><i class="bi bi-person-gear"></i> Management User / Admin</h5>
  <a href="/admin/users/create" class="btn btn-dark btn-sm"><i class="bi bi-plus-lg"></i> Tambah User</a>
</div>
<div class="card card-stat p-3">
  <table class="table table-hover align-middle">
    <thead><tr><th>Nama</th><th>Username</th><th>Email</th><th>Role</th><th>Status</th><th class="text-end">Aksi</th></tr></thead>
    <tbody>
      <% items.forEach(u => { %>
        <tr>
          <td><%= u.name %></td>
          <td><%= u.username %></td>
          <td><%= u.email %></td>
          <td><span class="badge bg-secondary text-uppercase"><%= u.role %></span></td>
          <td><%= u.is_active ? '<span class="badge bg-success">Aktif</span>' : '<span class="badge bg-danger">Nonaktif</span>' %></td>
          <td class="text-end">
            <a href="/admin/users/<%= u.id %>/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
            <form action="/admin/users/<%= u.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Hapus user ini?');">
              <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
