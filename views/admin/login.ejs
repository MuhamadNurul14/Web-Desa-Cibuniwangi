<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<title>Login Admin | Desa Cibuniwangi</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<style>
  body {
    background: linear-gradient(135deg, #1e293b, #334155);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .login-card {
    max-width: 400px;
    width: 100%;
    border: none;
    border-radius: 1rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, .3);
  }
  .btn-back {
    color: #64748b;
    transition: all 0.2s ease-in-out;
  }
  .btn-back:hover {
    color: #0d6efd;
  }
</style>
</head>
<body>
<div class="card login-card">
  <div class="card-body p-4">
    <div class="text-center mb-4">
      <i class="bi bi-building" style="font-size:2.5rem;color:#1e293b;"></i>
      <h4 class="mt-2 mb-0">Desa Cibuniwangi</h4>
      <small class="text-muted">Dashboard Admin</small>
    </div>

    <% if (typeof error !== 'undefined' && error.length) { %>
      <div class="alert alert-danger"><%= error[0] %></div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="mb-3">
        <label class="form-label">Username</label>
        <input type="text" name="username" class="form-control" required autofocus>
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" required>
      </div>
      <button class="btn btn-dark w-100" type="submit">
        <i class="bi bi-box-arrow-in-right me-1"></i> Login
      </button>
    </form>

    <!-- PEMISAH DAN TOMBOL KEMBALI KE BERANDA -->
    <hr class="my-4 text-muted opacity-25">

    <div class="text-center">
      <a href="/" class="btn-back text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Kembali ke Beranda Utama
      </a>
    </div>

  </div>
</div>
</body>
</html>   