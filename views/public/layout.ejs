<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | Desa <%= profile.nama_desa || 'Cibuniwangi' %></title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<style>
  body {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  }
  
  /* Styling Navbar Rapi & Presisi */
  .navbar {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  .navbar-brand img {
    height: 42px;
    width: 42px;
    object-fit: cover;
    border-radius: 50%;
  }
  .nav-link {
    font-weight: 500;
    color: #334155 !important;
    padding-left: 0.75rem !important;
    padding-right: 0.75rem !important;
    transition: color 0.2s ease;
  }
  .nav-link:hover {
    color: #2563eb !important;
  }

  /* Style Hero Section dengan Background Balai Desa + Light Glow & Glassmorphism */
  .hero-balai-desa {
    position: relative;
    min-height: 450px;
    /* Ganti lokasi file foto balai desa kamu di sini jika berbeda */
    background: url('/images/balai-desa.jpg') no-repeat center center/cover;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(6, 78, 59, 0.82) 0%, rgba(15, 23, 42, 0.75) 100%);
    z-index: 1;
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(52, 211, 153, 0.28) 0%, transparent 70%);
    z-index: 1;
    pointer-events: none;
  }
  .hero-glass-card {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  /* Utility CSS Tambahan */
  footer { background: #1e293b; color: #cbd5e1; }
  footer a { color: #cbd5e1; }
  .card-item { border: none; border-radius: .8rem; box-shadow: 0 2px 10px rgba(0,0,0,.06); height: 100%; }
  .section-title { font-weight: 700; border-left: 5px solid #2563eb; padding-left: .6rem; margin-bottom: 1.5rem; }
</style>
</head>
<body>

<!-- NAVBAR RAPI -->
<nav class="navbar navbar-expand-lg bg-white shadow-sm sticky-top">
  <div class="container-fluid px-md-5">
    
    <!-- Brand/Logo (Kiri) -->
<a class="navbar-brand d-flex align-items-center gap-2 me-lg-4" href="/">
  <% if (profile.logo) { %>
    <img src="/uploads/<%= profile.logo %>" alt="Logo">
  <% } else { %>
    <div class="rounded-circle bg-warning text-white fw-bold d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
      C
    </div>
  <% } %>
  <div class="d-flex flex-column">
    <span class="fw-bold lh-sm" style="font-size: 1.05rem; color: #1e429f; letter-spacing: 0.3px;">
      DESA <%= (profile.nama_desa || 'CIBUNIWANGI').replace(/^Desa\s+/i, '').toUpperCase() %>
    </span>
    <small class="text-muted fw-semibold" style="font-size: 0.65rem; letter-spacing: 0.5px;">
      KEC. BANJARHARJO · BREBES
    </small>
  </div>
</a>

    <!-- Toggle Button Mobile -->
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navigation Links & Action Buttons -->
    <div class="collapse navbar-collapse" id="navMain">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
        <li class="nav-item"><a class="nav-link" href="/">Beranda</a></li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Profile Desa</a>
          <ul class="dropdown-menu border-0 shadow-sm">
            <li><a class="dropdown-item" href="/profile/tentang-kami">Tentang Kami</a></li>
            <li><a class="dropdown-item" href="/profile/visi-misi">Visi Misi</a></li>
            <li><a class="dropdown-item" href="/profile/sejarah">Sejarah Desa</a></li>
            <li><a class="dropdown-item" href="/profile/geografis">Geografis Desa</a></li>
            <li><a class="dropdown-item" href="/profile/demografi">Demografi Desa</a></li>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Pemerintahan</a>
          <ul class="dropdown-menu border-0 shadow-sm">
            <li><a class="dropdown-item" href="/pemerintahan/struktur-organisasi">Struktur Organisasi</a></li>
            <li><a class="dropdown-item" href="/pemerintahan/perangkat-desa">Perangkat Desa</a></li>
            <li><a class="dropdown-item" href="/pemerintahan/lembaga-desa">Lembaga Desa</a></li>
          </ul>
        </li>

        <li class="nav-item"><a class="nav-link" href="/layanan">Layanan</a></li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Informasi</a>
          <ul class="dropdown-menu border-0 shadow-sm">
            <li><a class="dropdown-item" href="/informasi/berita">Berita</a></li>
            <li><a class="dropdown-item" href="/informasi/pengumuman">Pengumuman</a></li>
            <li><a class="dropdown-item" href="/informasi/agenda">Agenda Kegiatan</a></li>
            <li><a class="dropdown-item" href="/informasi/galeri">Galeri (Foto & Video)</a></li>
            <li><a class="dropdown-item" href="/informasi/apb-desa">APB Desa</a></li>
          </ul>
        </li>

        <li class="nav-item"><a class="nav-link" href="/potensi-desa">Potensi Desa</a></li>
        <li class="nav-item"><a class="nav-link" href="/produk-hukum">Produk Hukum</a></li>
        <li class="nav-item"><a class="nav-link" href="/kontak">Kontak</a></li>
      </ul>

      <!-- Action Buttons (Kanan) -->
      <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
        <a href="/layanan" class="btn btn-primary px-3 py-2 text-white fw-semibold shadow-sm" style="background-color: #2563eb; border: none; font-size: 0.9rem;">
          Layanan Online
        </a>
        <a href="/admin/login" class="btn btn-outline-dark px-3 py-2 fw-semibold" style="font-size: 0.9rem;">
          <i class="bi bi-box-arrow-in-right me-1"></i> Admin
        </a>
      </div>
    </div>

  </div>
</nav>

<% if (success && success.length) { %>
  <div class="container mt-3"><div class="alert alert-success alert-dismissible fade show" role="alert"><%= success[0] %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></div>
<% } %>
<% if (error && error.length) { %>
  <div class="container mt-3"><div class="alert alert-danger alert-dismissible fade show" role="alert"><%= error[0] %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></div>
<% } %>

<%- body %>

<!-- FOOTER -->
<footer class="pt-5 pb-3 mt-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-4">
        <h5 class="text-white">Desa <%= profile.nama_desa || 'Cibuniwangi' %></h5>
        <p><%= (profile.tentang_kami || '').substring(0,150) %></p>
      </div>
      <div class="col-md-4">
        <h6 class="text-white">Kontak</h6>
        <p class="mb-1"><i class="bi bi-geo-alt me-2"></i> <%= kontakInfo.alamat_kantor || '-' %></p>
        <p class="mb-1"><i class="bi bi-telephone me-2"></i> <%= kontakInfo.telepon || '-' %></p>
        <p class="mb-1"><i class="bi bi-envelope me-2"></i> <%= kontakInfo.email || '-' %></p>
      </div>
      <div class="col-md-4">
        <h6 class="text-white">Ikuti Kami</h6>
        <a href="<%= kontakInfo.facebook || '#' %>" class="me-3"><i class="bi bi-facebook fs-5"></i></a>
        <a href="<%= kontakInfo.instagram || '#' %>" class="me-3"><i class="bi bi-instagram fs-5"></i></a>
        <a href="<%= kontakInfo.youtube || '#' %>"><i class="bi bi-youtube fs-5"></i></a>
      </div>
    </div>
    <hr class="border-secondary my-4">
    <p class="text-center mb-0 small">&copy; <%= new Date().getFullYear() %> Pemerintah Desa <%= profile.nama_desa || 'Cibuniwangi' %>. All rights reserved.</p>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>