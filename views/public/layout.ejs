<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | Desa <%= profile.nama_desa || 'Cibuniwangi' %></title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<style>
  body{font-family:'Segoe UI',sans-serif;}
  .navbar-brand img{height:38px;margin-right:8px;}
  footer{background:#1e293b;color:#cbd5e1;}
  footer a{color:#cbd5e1;}
  .hero{background:linear-gradient(135deg,#166534,#22c55e);color:#fff;padding:70px 0;}
  .card-item{border:none;border-radius:.8rem;box-shadow:0 2px 10px rgba(0,0,0,.06);height:100%;}
  .section-title{font-weight:700;border-left:5px solid #22c55e;padding-left:.6rem;margin-bottom:1.5rem;}
</style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">
      <% if (profile.logo) { %><img src="/uploads/<%= profile.logo %>" alt="Logo"><% } %>
      Desa <%= profile.nama_desa || 'Cibuniwangi' %>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMain">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/">Beranda</a></li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Profile Desa</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/profile/tentang-kami">Tentang Kami</a></li>
            <li><a class="dropdown-item" href="/profile/visi-misi">Visi Misi</a></li>
            <li><a class="dropdown-item" href="/profile/sejarah">Sejarah Desa</a></li>
            <li><a class="dropdown-item" href="/profile/geografis">Geografis Desa</a></li>
            <li><a class="dropdown-item" href="/profile/demografi">Demografi Desa</a></li>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Pemerintahan</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/pemerintahan/struktur-organisasi">Struktur Organisasi</a></li>
            <li><a class="dropdown-item" href="/pemerintahan/perangkat-desa">Perangkat Desa</a></li>
            <li><a class="dropdown-item" href="/pemerintahan/lembaga-desa">Lembaga Desa</a></li>
          </ul>
        </li>

        <li class="nav-item"><a class="nav-link" href="/layanan">Layanan</a></li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Informasi</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/informasi/berita">Berita</a></li>
            <li><a class="dropdown-item" href="/informasi/pengumuman">Pengumuman</a></li>
            <li><a class="dropdown-item" href="/informasi/agenda">Agenda Kegiatan</a></li>
            <li><a class="dropdown-item" href="/informasi/galeri">Galeri (Foto & Video)</a></li>
            <li><a class="dropdown-item" href="/informasi/apb-desa">APB Desa</a></li>
          </ul>
        </li>

        <li class="nav-item"><a class="nav-link" href="/potensi-desa">Potensi Desa</a></li>
        <li class="nav-item"><a class="nav-link" href="/produk-hukum">Produk Hukum</a></li>
        <li class="nav-item"><a class="nav-link" href="/kontak">Kontak</a></li>
      </ul>
    </div>
  </div>
</nav>

<% if (success && success.length) { %>
  <div class="container mt-3"><div class="alert alert-success"><%= success[0] %></div></div>
<% } %>
<% if (error && error.length) { %>
  <div class="container mt-3"><div class="alert alert-danger"><%= error[0] %></div></div>
<% } %>

<%- body %>

<footer class="pt-5 pb-3 mt-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-4">
        <h5 class="text-white">Desa <%= profile.nama_desa || 'Cibuniwangi' %></h5>
        <p><%= (profile.tentang_kami || '').substring(0,150) %></p>
      </div>
      <div class="col-md-4">
        <h6 class="text-white">Kontak</h6>
        <p><i class="bi bi-geo-alt"></i> <%= kontakInfo.alamat_kantor || '-' %></p>
        <p><i class="bi bi-telephone"></i> <%= kontakInfo.telepon || '-' %></p>
        <p><i class="bi bi-envelope"></i> <%= kontakInfo.email || '-' %></p>
      </div>
      <div class="col-md-4">
        <h6 class="text-white">Ikuti Kami</h6>
        <a href="<%= kontakInfo.facebook || '#' %>" class="me-3"><i class="bi bi-facebook fs-5"></i></a>
        <a href="<%= kontakInfo.instagram || '#' %>" class="me-3"><i class="bi bi-instagram fs-5"></i></a>
        <a href="<%= kontakInfo.youtube || '#' %>"><i class="bi bi-youtube fs-5"></i></a>
      </div>
    </div>
    <hr class="border-secondary">
    <p class="text-center mb-0 small">&copy; <%= new Date().getFullYear() %> Pemerintah Desa <%= profile.nama_desa || 'Cibuniwangi' %>. All rights reserved.</p>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
