<div class="container my-5">
  <h3 class="section-title">Lembaga Desa</h3>
  <div class="row g-4">
    <% if (data.length === 0) { %><p class="text-muted">Belum ada data lembaga desa.</p><% } %>
    <% data.forEach(l => { %>
      <div class="col-md-4">
        <div class="card card-item p-3">
          <% if (l.logo) { %><img src="/uploads/<%= l.logo %>" style="height:70px;object-fit:contain;" class="mb-2"><% } %>
          <h6><%= l.nama_lembaga %> <small class="text-muted">(<%= l.singkatan %>)</small></h6>
          <p class="small">Ketua: <%= l.ketua %></p>
          <p class="small text-muted"><%= l.deskripsi %></p>
        </div>
      </div>
    <% }) %>
  </div>
</div>
