<div class="container my-5">
  <h3 class="section-title">Perangkat Desa</h3>
  <div class="row g-4">
    <% if (data.length === 0) { %><p class="text-muted">Belum ada data perangkat desa.</p><% } %>
    <% data.forEach(p => { %>
      <div class="col-md-3 col-6 text-center">
        <div class="card card-item p-3">
          <% if (p.foto) { %><img src="/uploads/<%= p.foto %>" class="rounded-circle mx-auto mb-2" style="width:100px;height:100px;object-fit:cover;">
          <% } else { %><i class="bi bi-person-circle mx-auto mb-2" style="font-size:5rem;color:#cbd5e1;"></i><% } %>
          <h6 class="mb-0"><%= p.nama %></h6>
          <small class="text-muted"><%= p.jabatan %></small>
        </div>
      </div>
    <% }) %>
  </div>
</div>
