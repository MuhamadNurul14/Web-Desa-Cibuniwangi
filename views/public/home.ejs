<!-- HERO SECTION (Background Balai Desa, Light Glow, & Glassmorphism) -->
<section class="hero-balai-desa text-center text-white py-5">
  <!-- Overlay Gradien & Efek Cahaya Terang di Tengah -->
  <div class="hero-overlay"></div>
  <div class="hero-glow"></div>

  <!-- Content Box Transparan (Kaca/Glassmorphism) -->
  <div class="container position-relative z-2 my-4">
    <div class="hero-glass-card mx-auto p-4 p-md-5 rounded-4 shadow-lg" style="max-width: 820px;">
      <h1 class="fw-bold display-6 display-md-5 mb-2">Selamat Datang di Website Resmi</h1>
      <h2 class="fw-extrabold text-success-light mb-3">
        Desa <%= (profile.nama_desa || 'Cibuniwangi').replace(/^Desa\s+/i, '') %>
      </h2>
      <p class="mt-3 mb-0 text-white-50 lead fs-6 fs-md-5">
        <%= (profile.tentang_kami || '').substring(0,180) %>
      </p>
    </div>
  </div>
</section>

<!-- MAIN CONTENT SECTION -->
<div class="container my-5">

  <!-- BERITA TERBARU -->
  <h4 class="section-title">Berita Terbaru</h4>
  <div class="row g-4 mb-5">
    <% if (berita.length === 0) { %>
      <p class="text-muted">Belum ada berita.</p>
    <% } %>
    <% berita.forEach(b => { %>
      <div class="col-md-4">
        <div class="card card-item">
          <% if (b.thumbnail) { %>
            <img src="/uploads/<%= b.thumbnail %>" class="card-img-top" style="height:180px;object-fit:cover;border-radius:.8rem .8rem 0 0;">
          <% } %>
          <div class="card-body">
            <h6 class="card-title"><%= b.judul %></h6>
            <p class="small text-muted"><%= b.tanggal_publish %></p>
            <a href="/informasi/berita/<%= b.slug %>" class="btn btn-sm btn-outline-primary">Baca Selengkapnya</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- PENGUMUMAN & AGENDA -->
  <div class="row g-4">
    <div class="col-md-6">
      <h4 class="section-title">Pengumuman</h4>
      <ul class="list-group">
        <% if (pengumuman.length === 0) { %>
          <li class="list-group-item text-muted">Belum ada pengumuman.</li>
        <% } %>
        <% pengumuman.forEach(p => { %>
          <li class="list-group-item">
            <strong><%= p.judul %></strong><br>
            <small class="text-muted"><%= p.tanggal_mulai %></small>
          </li>
        <% }) %>
      </ul>
    </div>
    <div class="col-md-6">
      <h4 class="section-title">Agenda Kegiatan</h4>
      <ul class="list-group">
        <% if (agenda.length === 0) { %>
          <li class="list-group-item text-muted">Belum ada agenda.</li>
        <% } %>
        <% agenda.forEach(a => { %>
          <li class="list-group-item">
            <strong><%= a.nama_kegiatan %></strong><br>
            <small class="text-muted"><%= a.tanggal_mulai %> — <%= a.lokasi %></small>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>

  <!-- GALERI -->
  <h4 class="section-title mt-5">Galeri</h4>
  <div class="row g-3">
    <% galeri.forEach(g => { %>
      <div class="col-md-3 col-6">
        <% if (g.tipe === 'foto' && g.file_path) { %>
          <img src="/uploads/<%= g.file_path %>" class="img-fluid rounded shadow-sm" style="height:140px;width:100%;object-fit:cover;">
        <% } %>
      </div>
    <% }) %>
  </div>

</div>