<section class="hero text-center">
  <div class="container">
    <h1 class="fw-bold">Selamat Datang di Website Resmi</h1>
    <h2>Desa <%= profile.nama_desa || 'Cibuniwangi' %></h2>
    <p class="mt-3 mb-0"><%= (profile.tentang_kami || '').substring(0,180) %></p>
  </div>
</section>

<div class="container my-5">
  <h4 class="section-title">Berita Terbaru</h4>
  <div class="row g-4 mb-5">
    <% if (berita.length === 0) { %><p class="text-muted">Belum ada berita.</p><% } %>
    <% berita.forEach(b => { %>
      <div class="col-md-4">
        <div class="card card-item">
          <% if (b.thumbnail) { %><img src="/uploads/<%= b.thumbnail %>" class="card-img-top" style="height:180px;object-fit:cover;border-radius:.8rem .8rem 0 0;"><% } %>
          <div class="card-body">
            <h6 class="card-title"><%= b.judul %></h6>
            <p class="small text-muted"><%= b.tanggal_publish %></p>
            <a href="/informasi/berita/<%= b.slug %>" class="btn btn-sm btn-outline-success">Baca Selengkapnya</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="row g-4">
    <div class="col-md-6">
      <h4 class="section-title">Pengumuman</h4>
      <ul class="list-group">
        <% if (pengumuman.length === 0) { %><li class="list-group-item text-muted">Belum ada pengumuman.</li><% } %>
        <% pengumuman.forEach(p => { %>
          <li class="list-group-item"><strong><%= p.judul %></strong><br><small class="text-muted"><%= p.tanggal_mulai %></small></li>
        <% }) %>
      </ul>
    </div>
    <div class="col-md-6">
      <h4 class="section-title">Agenda Kegiatan</h4>
      <ul class="list-group">
        <% if (agenda.length === 0) { %><li class="list-group-item text-muted">Belum ada agenda.</li><% } %>
        <% agenda.forEach(a => { %>
          <li class="list-group-item"><strong><%= a.nama_kegiatan %></strong><br><small class="text-muted"><%= a.tanggal_mulai %> — <%= a.lokasi %></small></li>
        <% }) %>
      </ul>
    </div>
  </div>

  <h4 class="section-title mt-5">Galeri</h4>
  <div class="row g-3">
    <% galeri.forEach(g => { %>
      <div class="col-md-3 col-6">
        <% if (g.tipe === 'foto' && g.file_path) { %>
          <img src="/uploads/<%= g.file_path %>" class="img-fluid rounded shadow-sm" style="height:140px;width:100%;object-fit:cover;">
        <% } %>
      </div>
    <% }) %>
  </div>
</div>
