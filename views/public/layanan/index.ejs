<div class="container my-5">
  <h3 class="section-title">Layanan Publik & Pengajuan Surat/Informasi</h3>
  <div class="row g-4 mb-5">
    <% if (data.length === 0) { %><p class="text-muted">Belum ada layanan tersedia.</p><% } %>
    <% data.forEach(l => { %>
      <div class="col-md-4">
        <div class="card card-item p-3">
          <i class="bi <%= l.icon || 'bi-file-earmark-text' %> fs-2 text-success mb-2"></i>
          <h6><%= l.nama_layanan %></h6>
          <p class="small text-muted"><%= l.deskripsi %></p>
          <p class="small"><strong>Syarat:</strong> <%= l.syarat %></p>
          <p class="small mb-0"><strong>Estimasi:</strong> <%= l.estimasi_waktu %> | <strong>Biaya:</strong> <%= l.biaya %></p>
        </div>
      </div>
    <% }) %>
  </div>

  <h4 class="section-title">Form Pengajuan Layanan / Surat</h4>
  <div class="card card-item p-4">
    <form action="/layanan" method="POST" enctype="multipart/form-data">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Pilih Layanan</label>
          <select name="layanan_id" class="form-select" required>
            <option value="">-- Pilih Layanan --</option>
            <% data.forEach(l => { %><option value="<%= l.id %>"><%= l.nama_layanan %></option><% }) %>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Nama Lengkap</label>
          <input type="text" name="nama_pemohon" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">NIK</label>
          <input type="text" name="nik" class="form-control">
        </div>
        <div class="col-md-4">
          <label class="form-label">No. HP</label>
          <input type="text" name="no_hp" class="form-control">
        </div>
        <div class="col-md-4">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control">
        </div>
        <div class="col-12">
          <label class="form-label">Alamat</label>
          <textarea name="alamat" class="form-control" rows="2"></textarea>
        </div>
        <div class="col-12">
          <label class="form-label">Keperluan</label>
          <textarea name="keperluan" class="form-control" rows="3" required></textarea>
        </div>
        <div class="col-12">
          <label class="form-label">Lampiran Pendukung (opsional)</label>
          <input type="file" name="file_lampiran" class="form-control">
        </div>
      </div>
      <button class="btn btn-success mt-4" type="submit"><i class="bi bi-send"></i> Kirim Pengajuan</button>
    </form>
  </div>
</div>
