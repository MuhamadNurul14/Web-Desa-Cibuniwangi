<div class="container my-5">
  <h3 class="section-title">Berita</h3>
  <div class="row g-4">
    <% if (data.length === 0) { %><p class="text-muted">Belum ada berita.</p><% } %>
    <% data.forEach(b => { %>
      <div class="col-md-4">
        <div class="card card-item">
          <% if (b.thumbnail) { %><img src="/uploads/<%= b.thumbnail %>" class="card-img-top" style="height:180px;object-fit:cover;border-radius:.8rem .8rem 0 0;"><% } %>
          <div class="card-body">
            <h6><%= b.judul %></h6>
            <p class="small text-muted"><%= b.tanggal_publish %> · <%= b.dilihat %> views</p>
            <a href="/informasi/berita/<%= b.slug %>" class="btn btn-sm btn-outline-success">Baca Selengkapnya</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>
