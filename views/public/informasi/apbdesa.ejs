<div class="container my-5">
  <h3 class="section-title">APB Desa (Transparansi Anggaran)</h3>
  <% tahunList.forEach(tahun => { %>
    <h5 class="mt-4"><%= tahun %></h5>
    <table class="table table-bordered">
      <thead><tr><th>Jenis</th><th>Uraian</th><th>Anggaran (Rp)</th><th>Realisasi (Rp)</th><th>Dokumen</th></tr></thead>
      <tbody>
        <% data.filter(d => d.tahun_anggaran === tahun).forEach(d => { %>
          <tr>
            <td class="text-capitalize"><%= d.jenis %></td>
            <td><%= d.uraian %></td>
            <td class="text-end"><%= Number(d.jumlah_anggaran).toLocaleString('id-ID') %></td>
            <td class="text-end"><%= Number(d.jumlah_realisasi).toLocaleString('id-ID') %></td>
            <td><% if (d.file_dokumen) { %><a href="/uploads/<%= d.file_dokumen %>" target="_blank"><i class="bi bi-file-earmark-pdf"></i></a><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% }) %>
  <% if (data.length === 0) { %><p class="text-muted">Belum ada data APB Desa.</p><% } %>
</div>
