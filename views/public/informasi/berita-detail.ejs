<div class="container my-5">
  <a href="/informasi/berita" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Kembali</a>
  <h3><%= item.judul %></h3>
  <p class="text-muted small"><%= item.penulis %> · <%= item.tanggal_publish %> · <%= item.dilihat %> views</p>
  <% if (item.thumbnail) { %><img src="/uploads/<%= item.thumbnail %>" class="img-fluid rounded mb-4"><% } %>
  <div style="white-space:pre-line;"><%- item.konten %></div>
</div>
