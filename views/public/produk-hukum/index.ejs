<div class="container my-5">
  <h3 class="section-title">Produk Hukum</h3>
  <p class="text-muted">Dokumen Peraturan Desa & SK Kepala Desa</p>
  <table class="table table-hover">
    <thead><tr><th>Jenis</th><th>Nomor</th><th>Tentang</th><th>Tahun</th><th>Tanggal Ditetapkan</th><th>Dokumen</th></tr></thead>
    <tbody>
      <% if (data.length === 0) { %><tr><td colspan="6" class="text-center text-muted">Belum ada dokumen.</td></tr><% } %>
      <% data.forEach(d => { %>
        <tr>
          <td><%= d.jenis %></td>
          <td><%= d.nomor %></td>
          <td><%= d.tentang %></td>
          <td><%= d.tahun %></td>
          <td><%= d.tanggal_ditetapkan %></td>
          <td><a href="/uploads/<%= d.file_dokumen %>" target="_blank" class="btn btn-sm btn-outline-success"><i class="bi bi-download"></i> Unduh</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
